import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

df = pd.read_csv('ecommerce.csv', encoding='utf-8-sig')
print(f'Число строк и столбцов: {df.shape}')
print(f'\nТипы признаков:\n{df.dtypes}')
print(f'\nДанные:\n{df.head(10)}')
print(f'\nОписательная статистика\n{df.describe(include='all')}')

target = 'покупка'
print(f'\nЦелевая переменная: {df[target].value_counts(dropna=False)}')
print(f'\nЧастоты категории промокод: \n{df['промокод'].value_counts(dropna=False)}')
print(f'\nЧастоты категории источник: \n{df['источник'].value_counts(dropna=False)}')

print(f'\nПропуски абсолютное число:\n{df.isna().sum().sort_values(ascending=False)}')
print(f'\nПропуски доля:\n{df.isna().mean().sort_values(ascending=False)}')

df['время_на_сайте_мин'].hist()
plt.xlabel('время на сайте(мин)')
plt.ylabel('частота')
plt.title('Распределение признака время на сайте')
plt.show()

sns.boxplot (x='покупка', y='время_на_сайте_мин', data = df)
plt.title('Время на сайте и факт покупки')
plt.ylabel('время на сайте(мин)')
plt.show()

sns.countplot(x='источник', hue='покупка', data=df)
plt.title('Покупки по источникам трафика')
plt.ylabel('частота')
plt.show()

sns.countplot(x='промокод', hue='покупка', data=df)
plt.title('Покупки и промокод')
plt.ylabel('частота')
plt.show()

sns.scatterplot(x='время_на_сайте_мин', y='просмотрено_товаров', hue='покупка', data=df)
plt.title('Время на сайте и число товаров')
plt.xlabel('время на сайте(мин)')
plt.ylabel('просмотрено товаров')
plt.show()

num = df.select_dtypes(include='number').drop(columns='сессия_id')
print(f'\nТаблица корреляции числовых признаков:\n{num.corr()}')
sns.heatmap(num.corr(), annot=True)
plt.title('Корреляции')
plt.show()

print('\nСтатистики по классам:')
print(df.groupby('покупка')[['время_на_сайте_мин', 'просмотрено_товаров']].describe())

print('\nИсточник и покупка (доли):')
print(pd.crosstab(df['источник'], df['покупка'], normalize='index').round(3))

print('\nПромокод и покупка (доли):')
print(pd.crosstab(df['промокод'], df['покупка'], normalize='index').round(3))
